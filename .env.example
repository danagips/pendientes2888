# Copiar los valores en Vercel → Settings → Environment Variables

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Texto al azar de 32 caracteres o más (firma las sesiones)
PENDIENTES_SECRET=

# Un PIN por persona. Para sacarle el acceso a alguien, borrarlo de acá y redeploy.
PENDIENTES_PINS={"dana":"0000","brico":"0000","nico":"0000","tami":"0000","vero":"0000"}
